    "README": [
      {
        "key": "status",
        "value": "DEVELOPMENT. Publish as a new version after local validation; remote writes require consent, confirmation, and provider evidence."
      },
      {
        "key": "goal",
        "value": "One explicitly confirmed company formation Business Goal across seven consecutive stages, interrupted by knowledge and support questions without losing context."
      },
      {
        "key": "safety",
        "value": "Do not collect contacts or issue CRM writes for knowledge-only dialogue. All side effects require separate purpose-specific consent, explicit confirmation, idempotency, and Node-verified provider evidence."
      },
      {
        "key": "stage_order",
        "value": "lead_generation > lead_qualification > account_creation > package_selection > document_upload > payment_invoice > contract"
      },
      {
        "key": "facts",
        "value": "Prices, fees, eligibility and policy claims must originate from authorized versioned RAG sources; this draft contains no fees or authoritative regulatory advice."
      },
      {
        "key": "publication",
        "value": "Development bindings include the active remote n8n lead and quotation workflows; retain prior published versions for rollback."
      }
    ],

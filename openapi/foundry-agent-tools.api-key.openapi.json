{
  "openapi": "3.0.3",
  "info": {
    "title": "Agentic RAG Foundry Agent Tools (Development API Key)",
    "version": "1.0.0",
    "description": "Development-only read-only Foundry tool variant. Do not import or enable this variant for production."
  },
  "servers": [{ "url": "https://c3srnt4h-80.inc1.devtunnels.ms", "description": "Replace with the verified HTTPS Node API origin." }],
  "security": [{ "foundryApiKey": [] }],
  "paths": {
    "/api/v1/foundry/tools/search-knowledge": {
      "post": {
        "operationId": "search_knowledge",
        "summary": "Search approved tenant knowledge",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchKnowledgeRequest" } } } },
        "responses": {
          "200": { "description": "Grounded evidence or no evidence.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchKnowledgeResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" }, "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/v1/foundry/tools/get-journey-state": {
      "post": {
        "operationId": "get_journey_state",
        "summary": "Read the authorized customer journey state",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false }, "example": {} } } },
        "responses": {
          "200": { "description": "Sanitized journey state or not linked.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JourneyStateResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" }, "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "foundryApiKey": { "type": "apiKey", "in": "header", "name": "X-Foundry-Api-Key", "description": "Development-only secret configured outside source control and scoped to one development tenant." }
    },
    "schemas": {
      "SearchKnowledgeRequest": { "type": "object", "additionalProperties": false, "required": ["query"], "properties": { "query": { "type": "string", "minLength": 1, "maxLength": 1000 }, "maxResults": { "type": "integer", "minimum": 1, "maximum": 8, "default": 4 } } },
      "KnowledgeCitation": { "type": "object", "additionalProperties": false, "required": ["sourceId", "title", "chunkId", "locator", "excerpt"], "properties": { "sourceId": { "type": "string" }, "title": { "type": "string" }, "chunkId": { "type": "string" }, "locator": { "type": "string" }, "excerpt": { "type": "string" } } },
      "SearchKnowledgeResponse": { "type": "object", "additionalProperties": false, "required": ["status", "answer", "citations"], "properties": { "status": { "type": "string", "enum": ["grounded", "no_evidence"] }, "answer": { "type": "string" }, "citations": { "type": "array", "maxItems": 8, "items": { "$ref": "#/components/schemas/KnowledgeCitation" } } } },
      "JourneyStateResponse": { "type": "object", "additionalProperties": false, "required": ["status", "currentStage", "completedStages", "nextRequirement"], "properties": { "status": { "type": "string", "enum": ["available", "not_linked"] }, "currentStage": { "type": "string", "nullable": true, "enum": ["lead_generation", "lead_qualification", "account_creation", "package_selection", "document_upload", "billing_invoice", "contract"] }, "completedStages": { "type": "array", "items": { "type": "string" } }, "nextRequirement": { "type": "string", "nullable": true }, "revision": { "type": "integer", "minimum": 0 } } },
      "Error": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "requestId": { "type": "string" } } } } }
    },
    "responses": {
      "Unauthorized": { "description": "Authentication failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Tenant authorization failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ValidationError": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "RateLimited": { "description": "Per-identity rate limit exceeded.", "headers": { "Retry-After": { "schema": { "type": "integer" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unavailable": { "description": "The read-only tool is temporarily unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}

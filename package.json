{
  "name": "agentic-rag-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/chat-utils && npm run build --workspaces --if-present",
    "verify:compose": "node scripts/verify-compose.mjs",
    "verify:compose:local": "node scripts/verify-compose-local.mjs",
    "verify:conversation-boundary": "node scripts/verify-conversation-engine-boundary.mjs",
    "verify:n8n:salesforce": "node scripts/verify-n8n-salesforce-lead-runtime.mjs",
    "acceptance:n8n:remote": "node scripts/acceptance-remote-n8n.mjs",
    "activate:n8n:dev": "node scripts/activate-ancfz-n8n-dev.mjs --confirm-dev",
    "test:salesforce:webhook:mock": "node scripts/test-salesforce-lead-webhook.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:secrets:test": "node --test scripts/verify-secrets.test.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "acceptance:local": "node scripts/acceptance-local.mjs",
    "acceptance:seed": "node scripts/seed-acceptance-local.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "test": "npm run test:unit",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace services/api && npm run lint:ui",
    "dev:api": "npm --workspace services/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:admin": "npm --workspace apps/admin run start",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:migrate": "node scripts/migrate-local.mjs",
    "db:migrate:vm": "node scripts/migrate-vm.mjs",
    "test:unit": "npm run test --workspaces --if-present",
    "lint:ui": "eslint --config .github/eslint-ui.config.mjs \"apps/web/**/*.{ts,tsx}\" \"apps/admin/src/**/*.ts\" --max-warnings 0",
    "check:null-safety": "node scripts/check-typescript-null-safety.mjs",
    "p7:validate": "node --test scripts/p7-uat-gates.test.mjs",
    "p7:dry-run": "node scripts/p7-azure-uat.mjs --dry-run",
    "p7:azure": "node scripts/p7-azure-uat.mjs --run"
  },
  "devDependencies": {
    "@angular/compiler": "^21.2.26"
  },
  "engines": {
    "node": ">=22"
  }
}

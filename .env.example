# Copy to .env and replace every placeholder before VM use.
# One docker-compose.yml starts the private Python GPT gateway automatically.

# Runtime and storage
NODE_ENV=development
PORT=4000
STORE=postgres
POSTGRES_PASSWORD=replace-with-a-long-postgres-secret
DB_MIGRATION_BASELINE=
DATABASE_URL=postgres://agentic:replace-with-a-long-postgres-secret@postgres:5432/agentic_rag
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
# When REDIS_PASSWORD is set, use redis://default:<password>@redis:6379 for REDIS_URL.

# API security and channel authentication
JWT_SECRET=replace-with-a-long-jwt-secret
CHANNEL_CREDENTIAL_KEY=replace-with-a-long-channel-credential-key
PII_VAULT_KEY=replace-with-a-long-vault-secret
INGESTION_WORKER_SECRET=replace-with-a-long-ingestion-worker-secret
CHAT_STREAM_INTERNAL_SECRET=replace-with-a-long-chat-stream-internal-secret
N8N_WEBHOOK_SECRET=replace-with-a-long-n8n-webhook-secret
QUOTE_PDF_API_KEY=replace-with-a-long-private-quote-pdf-secret

OMNI_CHANNEL_API_KEY=
OMNI_CHANNEL_TENANT_ID=
OMNI_CHANNEL_TENANT_SLUG=
OMNI_CHANNEL_NAME=omnichannel
OMNI_ALLOW_STATIC_API_KEY=false

# Web, admin and local ingress
PUBLIC_ORIGIN=http://localhost
WEB_ORIGIN=http://localhost
ADMIN_ORIGIN=http://localhost
NEXT_PUBLIC_API_URL=/
ADMIN_BASE_HREF=/admin/
APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=80
# Only Nginx publishes port 80; PostgreSQL/Redis are internal Docker services.

# Chat and API behavior
CHAT_MODEL_PROVIDER=python-gpt
CHAT_RESPONSE_CACHE_TTL_SECONDS=60
CHAT_SESSION_TTL_MS=600000
# Require per-session credentials for public chat. Production enforces this even if overridden.
CHAT_SESSION_TOKEN_REQUIRED=true
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=60000
CATALOG_QUERY_NORMALIZATION_ENABLED=false
# Conversation Engine v2 is the default path when the private gateway is configured.
# Set false only for an emergency rollback; the tenant list remains an independent gate.
CONVERSATION_ENGINE_V2_ENABLED=true
CONVERSATION_ENGINE_V2_TENANTS=
CONVERSATION_ENGINE_V2_REQUIRED=true
# The private gateway remains internal-only; its readiness check fails closed when Azure is missing.
LANGGRAPH_CONVERSATION_ENABLED=true

# Azure embeddings used by Node retrieval
AZURE_AI_ENDPOINT=
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_AI_EMBEDDING_DIMENSION=1536
AZURE_AI_API_KEY=
AZURE_AI_API_VERSION=2024-10-21
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_API_KEY=

# n8n, event workers and remote CRM
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_PATH=/n8n/
N8N_PROXY_HOPS=1
# Internal container traffic uses n8n's root route; /n8n/ is only the public proxy path.
N8N_INTERNAL_URL=http://n8n:5678
NODE_INTERNAL_URL=http://api:4000
N8N_EDITOR_BASE_URL=http://localhost/n8n/
N8N_WEBHOOK_URL=http://localhost/n8n/
N8N_SECURE_COOKIE=false
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=false
N8N_INSTANCE_OWNER_EMAIL=
N8N_INSTANCE_OWNER_PASSWORD_HASH=
N8N_INSTANCE_OWNER_FIRST_NAME=Admin
N8N_INSTANCE_OWNER_LAST_NAME=TechCarrot
N8N_COMPLETION_DEADLINE_MS=900000
EVENT_WORKER_STREAMS=rag:v2:crm,rag:v2:documents,rag:v2:actions,rag:v2:notifications
# Optional reviewed remote n8n acceptance endpoints. Keep credentials out of Git.
REMOTE_N8N_BASE_URL=https://ai.techcarrot.ae
REMOTE_N8N_SALESFORCE_LEAD_PATH=/n8n/webhook/salesforce-lead
REMOTE_N8N_QUOTATION_PATH=/n8n/webhook/generate-quotation
REMOTE_N8N_QUOTATION_API_KEY=
REMOTE_N8N_QUOTE_ACCOUNT_ID=
REMOTE_CRM_PROVIDER=
REMOTE_CRM_LEAD_URL=
REMOTE_CRM_LEAD_READ_URL=
REMOTE_CRM_ACCOUNT_URL=
REMOTE_CRM_ACCOUNT_READ_URL=
REMOTE_CRM_ACCESS_TOKEN=
REMOTE_CRM_TOKEN_URL=
REMOTE_CRM_CLIENT_ID=
REMOTE_CRM_CLIENT_SECRET=
V2_LEAD_WORKFLOW_READY=false
# Local/dev readiness is verified separately with `npm run verify:n8n:salesforce`.
# Keep this false until the reviewed workflow and credentials are active.
REMOTE_CRM_LEAD_ID_PATTERN=^[A-Za-z0-9._:-]{1,200}$

# Ingestion worker
INGESTION_POLL_INTERVAL_SECONDS=5
# ZIP member parsing is serial; pause between documents to reduce load.
INGESTION_ZIP_MEMBER_DELAY_SECONDS=1.0
INGESTION_LEASE_MS=120000
INGESTION_RESULT_TIMEOUT_SECONDS=600

# Optional local quote PDF mock provider
QUOTE_PDF_RENDER_URL=http://quote-pdf:8097/v1/render
# Required only when the opt-in quote profile is enabled; use a random local-only value of at least 24 characters.
QUOTE_PDF_API_KEY=
QUOTE_WORKFLOW_ENABLED=false
MOCK_PAYMENT_INTERNAL_URL=http://mock-payments:8098
# Required only when the opt-in quote profile is enabled; use a random local-only value of at least 20 characters.
MOCK_PAYMENT_API_KEY=

# Private Python GPT model gateway
# MODEL_MODE=mock is the offline test mode; any other value uses AI_PROVIDER.
MODEL_MODE=azure
# Select one active profile. The local OpenAI profile is gpt-5.4; the Azure
# profile should set AI_MODEL to the deployed gpt-5.4 deployment name.
AI_PROVIDER=openai
AI_MODEL=gpt-5.4
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Optional provider-specific fallbacks. Keep credentials in the private runtime only.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_KEY=
MODEL_GATEWAY_SERVICE_KEY=
PYTHON_MODEL_URL=http://model-gateway:8088
NODE_TOOL_GATEWAY_URL=http://api:4000
MODEL_MAX_CONCURRENCY=2
MODEL_MIN_CALL_INTERVAL_SECONDS=0.7
MODEL_MAX_REQUESTS_PER_MINUTE=60
MODEL_TURN_TIMEOUT_SECONDS=120
MODEL_CIRCUIT_BREAKER_FAILURES=3
MODEL_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
PYTHON_MODEL_TIMEOUT_MS=120000
# Experimental claim entailment reviewer: off until calibrated against held-out quality/safety cases.
V2_GROUNDING_ENTAILMENT_MODE=off
V2_GROUNDING_TIMEOUT_MS=10000

# Copy to .env and replace every placeholder before VM use.
# Select docker-compose.python-gpt.yml to enable the private Python GPT gateway.

NODE_ENV=development
PORT=4000
STORE=postgres
POSTGRES_PASSWORD=replace-with-a-long-postgres-secret
DATABASE_URL=postgres://agentic:replace-with-a-long-postgres-secret@127.0.0.1:54329/agentic_rag
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=replace-with-a-long-jwt-secret
CHANNEL_CREDENTIAL_KEY=replace-with-a-long-channel-credential-key
PII_VAULT_KEY=replace-with-a-long-vault-secret
INGESTION_WORKER_SECRET=replace-with-a-long-ingestion-worker-secret
N8N_WEBHOOK_SECRET=replace-with-a-long-n8n-webhook-secret

WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=/
ADMIN_BASE_HREF=/admin/

CHAT_MODEL_PROVIDER=deterministic
AZURE_AI_ENDPOINT=
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_AI_EMBEDDING_DIMENSION=1536
AZURE_AI_API_KEY=
AZURE_AI_API_VERSION=2024-10-21

N8N_INTERNAL_URL=http://n8n:5678
N8N_EDITOR_BASE_URL=http://localhost:3000/n8n/
N8N_WEBHOOK_URL=http://localhost:3000/n8n/
N8N_SECURE_COOKIE=false

# VM ingress defaults to loopback; change only with an approved firewall/ingress policy.
APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=3000

# Loopback-only host ports used by local-dev for migrations and host diagnostics.
LOCAL_APP_PORT=3000
LOCAL_POSTGRES_PORT=54329
LOCAL_REDIS_PORT=6379

# Private Python GPT model gateway (add docker-compose.python-gpt.yml)
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
MODEL_GATEWAY_SERVICE_KEY=
MODEL_MAX_CONCURRENCY=2
MODEL_MIN_CALL_INTERVAL_SECONDS=0.7
MODEL_MAX_REQUESTS_PER_MINUTE=60
MODEL_TURN_TIMEOUT_SECONDS=90
MODEL_CIRCUIT_BREAKER_FAILURES=3
MODEL_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
PYTHON_MODEL_TIMEOUT_MS=90000
